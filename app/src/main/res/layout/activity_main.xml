<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.pedro.library.view.OpenGlView
        android:id="@+id/openGlView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Network quality indicator (top-left) -->
    <TextView
        android:id="@+id/networkStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/network_unknown"
        android:textColor="@android:color/white"
        android:background="#66000000"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="8dp" />

    <!-- Streaming timer indicator (below network status) -->
    <TextView
        android:id="@+id/streamingTimerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Streaming: 00:00:00"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:background="#66000000"
        android:layout_below="@id/networkStatusText"
        android:layout_alignParentStart="true"
        android:layout_margin="8dp" />

    <!-- Current bitrate indicator (below streaming timer) -->
    <TextView
        android:id="@+id/bitrateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/bitrate_label"
        android:textColor="@android:color/white"
        android:background="#66000000"
        android:layout_below="@id/streamingTimerText"
        android:layout_alignParentStart="true"
        android:layout_margin="8dp" />

    <!-- Stop button fixed at the bottom -->
    <Button
        android:id="@+id/stopButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stop_transmission"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp" />

    <!-- Start button positioned above Stop button -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_transmission"
        android:layout_above="@id/stopButton"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp" />

</RelativeLayout>